# .env.example 을 .env 로 복사한 뒤 값을 채웁니다. .env 는 절대 커밋하지 않습니다.

# 키움증권 REST API — 실전투자 앱키 (이 책에서는 시세 조회·과거 분봉 수집에만 사용)
KIWOOM_REAL_APP_KEY=
KIWOOM_REAL_APP_SECRET=
KIWOOM_REAL_ACCOUNT_NO=

# 키움증권 REST API — 모의투자 앱키·계좌 (10~11장 모의주문 실습)
KIWOOM_PAPER_APP_KEY=
KIWOOM_PAPER_APP_SECRET=
KIWOOM_PAPER_ACCOUNT_NO=

# 실행 모드: offline(샘플 데이터) | paper(모의투자). real 주문은 코드에서 차단합니다
TRADING_MODE=offline
DATA_DIR=./data
# 장 시각 기준 시간대. TZ 라는 이름은 Windows에서 로컬 시각을 UTC로 바꿔 버리므로 쓰지 않는다
MARKET_TZ=Asia/Seoul
